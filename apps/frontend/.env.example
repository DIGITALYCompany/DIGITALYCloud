# Frontend settings (copy to .env.local). NEXT_PUBLIC_* values are public and compiled into the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Optional, server-only:
# API_INTERNAL_URL=http://api.internal:4000/v1   # private API address for server-rendered pages (/status)
# AUTH_PROXY_GUARD=off                           # when the API session cookie isn't visible to this host
