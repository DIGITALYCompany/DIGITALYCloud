{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "DIGITALYCloud API, deployment workers and collectors (Express 5, MongoDB/Mongoose, Redis/BullMQ, Docker).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "env:init": "node scripts/env-init.mjs",
    "dev:infra": "tsx scripts/dev-infra.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "cli": "tsx src/cli.ts",
    "db:migrate": "tsx src/cli.ts migrate up",
    "db:migrate:status": "tsx src/cli.ts migrate status",
    "db:seed": "tsx src/cli.ts seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@digitalycloud/shared": "*",
    "@octokit/auth-app": "^8.3.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.4",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "stripe": "^23.0.0",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^11.3.0",
    "redis-memory-server": "^0.17.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
