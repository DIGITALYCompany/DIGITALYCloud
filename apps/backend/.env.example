# DIGITALYCloud backend — local development settings.
# `npm run env:init` copies this file to .env and fills in the three __generate__ secrets.
# All other variables have working defaults; the full list with production notes is in
# docs/operations.md ("Configuration reference").

# Core (required)
MONGODB_URI=mongodb://127.0.0.1:27017/digitalycloud?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
ENCRYPTION_KEYS=__generate__
ENCRYPTION_PRIMARY_KEY_ID=k1
APP_SECRET=__generate__

# Addresses
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Private listener (metrics, readiness, Traefik route feed)
INTERNAL_PORT=4001
INTERNAL_API_TOKEN=__generate__

# Email via Mailpit (compose.yaml). Empty = links are logged instead of sent.
SMTP_URL=smtp://127.0.0.1:1025

# Runtime: "disabled" (nothing runs) or "docker" (then: npm run cli -- server add-local)
RUNTIME_DRIVER=disabled
PUBLIC_RUNTIME_DOMAIN=localtest.me
PUBLIC_RUNTIME_SCHEME=http
PUBLIC_RUNTIME_PORT=8080
# RUNTIME_ALLOW_UNENFORCED_STORAGE=true   # laptops/Docker Desktop can't enforce disk quotas

# Optional providers: fill a whole group or leave it empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=
