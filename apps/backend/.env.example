# DIGITALYCloud backend settings. Copy to .env and fill in the values.
# `npm run env:init` does the copy and generates ENCRYPTION_KEYS, ENCRYPTION_PRIMARY_KEY_ID,
# APP_SECRET and INTERNAL_API_TOKEN for you.
# An empty value means "use the default" given in the comment. Full list: docs/operations.md.

# --- Required
# MongoDB connection string; must be a replica set (?replicaSet=… or Atlas)
MONGODB_URI=
# Redis connection string
REDIS_URL=
# Encryption key ring: kid:base64 of 32 random bytes (keep a safe copy, data can't be read without it)
ENCRYPTION_KEYS=
# The kid from ENCRYPTION_KEYS that encrypts new data
ENCRYPTION_PRIMARY_KEY_ID=
# Random secret, at least 32 characters
APP_SECRET=

# --- Addresses (empty = http://localhost:4000 and http://localhost:3000)
API_PUBLIC_URL=
FRONTEND_URL=

# --- Private listener for Traefik, metrics and readiness (empty port = off; the token is required when a port is set)
INTERNAL_PORT=
INTERNAL_API_TOKEN=

# --- Email via Brevo
# API key from app.brevo.com → SMTP & API → API Keys (starts with xkeysib-). Secret: put it in .env only.
# Empty = no email is sent; development logs the links instead.
BREVO_API_KEY=
# Sender shown on emails; the address must be a sender or domain verified in Brevo
BREVO_SENDER_EMAIL=no-reply@digitaly.fr
BREVO_SENDER_NAME=DIGITALYCloud
# Inbox that receives support tickets and contact-form messages
SUPPORT_INBOX=support@digitaly.fr

# --- Customer apps
# "docker" to run apps on registered servers (empty = disabled, nothing runs)
RUNTIME_DRIVER=
# Public app address {id}.{domain} (empty = digitaly.app, https, no port)
PUBLIC_RUNTIME_DOMAIN=
PUBLIC_RUNTIME_SCHEME=
PUBLIC_RUNTIME_PORT=
# "true" only on laptops/Docker Desktop that can't enforce disk quotas (refused in production)
RUNTIME_ALLOW_UNENFORCED_STORAGE=

# --- Optional providers: fill a whole group or leave it all empty
# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (STRIPE_PRICES is a JSON map of the 12 paid plans, see docs/operations.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=
